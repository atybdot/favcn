{
  "name": "favcn",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": ["packages/*"],
    "catalog": {
      "dotenv": "^18.0.9",
      "zod": "^4.6.7",
      "lucide-react": "^1.66.0",
      "next-themes": "^0.4.6",
      "react": "^19.3.1",
      "react-dom": "^19.3.1",
      "sonner": "^2.0.8",
      "tailwindcss": "^4.3.3",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0"
    }
  },
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js dev",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "serve": "node ./node_modules/vite/bin/vite.js preview",
    "deploy": "node ./node_modules/vite/bin/vite.js build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "check-types": "tsc --noEmit",
    "check": "oxlint && oxfmt --write",
    "format": "oxfmt --write",
    "prepare": "husky"
  },
  "dependencies": {
    "@favicon/env": "workspace:*",
    "@favicon/ui": "workspace:*",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-query": "^5.80.6",
    "@tanstack/react-router": "^1.141.1",
    "@tanstack/react-router-with-query": "^1.130.17",
    "@tanstack/react-start": "^1.141.1",
    "@tanstack/router-plugin": "^1.141.1",
    "@vercel/analytics": "^2.0.1",
    "dotenv": "catalog:",
    "geist": "^1.7.0",
    "jszip": "^3.10.1",
    "lucide-react": "catalog:",
    "next-themes": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-dropzone": "^15.0.0",
    "sonner": "catalog:",
    "tailwindcss": "catalog:",
    "vite-tsconfig-paths": "^5.1.4",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.40.0",
    "@favicon/config": "workspace:*",
    "@tanstack/react-router-devtools": "^1.141.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.2.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^5.0.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "husky": "^9.1.7",
    "jsdom": "^26.0.0",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "react-grab": "^0.1.27",
    "typescript": "^5",
    "vite": "^7.0.2",
    "web-vitals": "^5.0.3",
    "wrangler": "^4.98.0"
  },
  "lint-staged": {
    "*": ["oxlint", "oxfmt --write"]
  },
  "packageManager": "bun@1.4.4"
}
